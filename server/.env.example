# Copy this file to .env and fill in YOUR OWN values. Never commit .env.

NODE_ENV=development
PORT=5000

# --- Database (SQL) ---------------------------------------------------------
# Leave DATABASE_URL empty in development: the API creates a local SQLite file
# (server/data/quiet-battles.sqlite). Nothing to install.
# For production use PostgreSQL (Render, Neon, Supabase...) and paste its URL:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Generate a long random string (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# 'lax' when client and API share a site (local dev). Use 'none' if the client
# (Vercel) and the API (Render) are on different domains in production.
COOKIE_SAMESITE=lax

# --- URLs -------------------------------------------------------------------
# Where the React app runs (CORS allow-list). Comma-separate several origins.
CLIENT_URL=http://localhost:5173
# Public website address, used in sitemap.xml
SITE_URL=http://localhost:5173

# --- First admin account (used ONLY by `npm run seed`) ----------------------
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: Cloudinary image hosting -------------------------------------
# Leave empty to store uploads on disk in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
