# Copy this file to .env and fill in YOUR OWN values. Never commit .env.

NODE_ENV=development
PORT=5000

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local SQLite development.
# For Netlify, use your provider's pooled PostgreSQL URL (Neon pooled URL recommended).
# Keep the provider's SSL parameters; percent-encode reserved password characters.
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Generate a long random string (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Keep 'lax' when the API function is served on the same Netlify site as the frontend.
COOKIE_SAMESITE=lax

# --- URLs -------------------------------------------------------------------
# Production frontend origin (CORS allow-list). Add Preview origins only if needed.
CLIENT_URL=http://localhost:5173
# Public website address, used in sitemap.xml
SITE_URL=http://localhost:5173

# --- First admin account (used ONLY by `npm run seed`) ----------------------
ADMIN_NAME=Store Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Supabase Storage (production) ------------------------------------------
# SUPABASE_URL is the project URL. Use a server-only secret API key here;
# never use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for privileged uploads.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-media

# --- Optional: Cloudinary image hosting -------------------------------------
# Supabase Storage is preferred when configured; Cloudinary remains supported.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
