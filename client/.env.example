# Leave empty in development (Vite proxies /api to the server).
# Leave empty on Netlify (function route) and any host that rewrites /api locally.
VITE_API_URL=

# Optional: set true only when Supabase Storage Image Transformations are enabled
# on your project (Pro plan or higher). This creates responsive WebP srcsets.
VITE_SUPABASE_IMAGE_TRANSFORMS=false
